// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Use DATABASE_URL (works with Neon, Supabase, Railway, etc.)
  // For Vercel Postgres, set DATABASE_URL to the same value as POSTGRES_URL
  url      = env("DATABASE_URL")
}

model MenuItem {
  id              String   @id @default(cuid())
  name            String
  description     String?
  price           Float
  category        String   // "burger", "wrap", "fries", "drink"
  image           String?
  available       Boolean  @default(true)
  availableInMeal Boolean  @default(false) // Whether this item can be selected in the meal
  mealCategory    String?  // "main", "side", "drink" - which category in the meal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orderItems      OrderItem[]
  mealItems       MealItem[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          UserRole  @default(CUSTOMER)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
}

model Order {
  id                  String      @id @default(cuid())
  userId              String?
  customerName        String
  customerEmail       String
  customerPhone       String
  deliveryAddress     String
  city                String
  postalCode          String?
  totalAmount         Float
  status              OrderStatus @default(PENDING)
  paymentStatus       PaymentStatus @default(PENDING)
  stripePaymentId     String?
  arrivalNotification DateTime?   // When customer marked themselves as arrived
  arrivalAcknowledged Boolean     @default(false) // Whether admin has acknowledged the arrival
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  menuItemId  String?
  mealId      String?
  quantity    Int
  price       Float
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id])
  meal        Meal?    @relation(fields: [mealId], references: [id])
  createdAt   DateTime @default(now())
}

model Meal {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  image       String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       MealItem[]
  orderItems  OrderItem[]
}

model MealItem {
  id          String   @id @default(cuid())
  mealId      String
  menuItemId  String
  meal        Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  
  @@unique([mealId, menuItemId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

