// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Use DATABASE_URL (works with Neon, Supabase, Railway, etc.)
  // For Vercel Postgres, set DATABASE_URL to the same value as POSTGRES_URL
  url      = env("DATABASE_URL")
}

model MenuItem {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Float
  category    String // "burger", "wrap", "fries", "drink"
  image       String?
  available   Boolean        @default(true)
  order       Int            @default(0) // Display order within category
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orderItems  OrderItem[]
  mealOptions MealOption[]
  meals       MenuItemMeal[] // Meals linked to this menu item
  addOns      AddOn[]        // Add-ons available for this menu item
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      UserRole @default(CUSTOMER)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id                  String        @id @default(cuid())
  userId              String?
  customerName        String
  customerEmail       String
  customerPhone       String
  deliveryAddress     String
  city                String
  postalCode          String?
  carDetails          String? // Car details for collection orders (optional)
  totalAmount         Float
  status              OrderStatus   @default(PENDING)
  paymentStatus       PaymentStatus @default(PENDING)
  stripePaymentId     String?
  arrivalNotification DateTime? // When customer marked themselves as arrived
  arrivalAcknowledged Boolean       @default(false) // Whether admin has acknowledged the arrival
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  items               OrderItem[]
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model OrderItem {
  id                  String    @id @default(cuid())
  orderId             String
  menuItemId          String?
  mealId              String?
  selectedMealOptions Json? // Store selected meal options: [{ categoryId, menuItemId, additionalPrice }]
  selectedAddOns      Json? // Store selected add-ons: [{ addOnId, name, price }]
  quantity            Int
  price               Float
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem            MenuItem? @relation(fields: [menuItemId], references: [id])
  meal                Meal?     @relation(fields: [mealId], references: [id])
  createdAt           DateTime  @default(now())
}

model Meal {
  id             String         @id @default(cuid())
  name           String         @default("Meal Deal")
  description    String?
  basePrice      Float // Base price of the meal
  image          String?
  available      Boolean        @default(true)
  categoryFilter String? // Category this meal applies to (e.g., "burger", "wrap", "fries")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  categories     MealCategory[] // Dynamic categories for this meal
  options        MealOption[]
  orderItems     OrderItem[]
  menuItems      MenuItemMeal[] // Menu items linked to this meal
}

model MealCategory {
  id        String       @id @default(cuid())
  mealId    String
  name      String // Name of the category (e.g., "Fries", "Drink", "Side")
  order     Int // Order of display (1, 2, 3, etc.)
  meal      Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  options   MealOption[]
  createdAt DateTime     @default(now())

  @@unique([mealId, order])
  @@index([mealId])
}

model MealOption {
  id              String       @id @default(cuid())
  mealId          String
  categoryId      String // Reference to MealCategory instead of fixed number
  menuItemId      String
  additionalPrice Float        @default(0) // Additional price on top of base meal price (can be 0 for included items)
  meal            Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  category        MealCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  menuItem        MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@unique([mealId, categoryId, menuItemId])
  @@index([mealId, categoryId])
}

model MenuItemMeal {
  id         String   @id @default(cuid())
  menuItemId String
  mealId     String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([menuItemId, mealId])
  @@index([menuItemId])
  @@index([mealId])
}

model AddOn {
  id          String    @id @default(cuid())
  menuItemId  String    // The menu item this add-on belongs to
  name        String    // Name of the add-on (e.g., "Fries", "Drink", "Fries + Drink")
  price       Float     // Additional price for this add-on
  available   Boolean   @default(true)
  order       Int       @default(0) // Display order
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([menuItemId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum UserRole {
  CUSTOMER
  ADMIN
}
